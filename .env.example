# .env.example - Copy to .env and fill in your values

# =============================================================================
# CRITICAL SECURITY SETTINGS
# =============================================================================

# Secret key for session management and security (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme_generate_a_secure_random_key

# =============================================================================
# USER AUTHENTICATION
# =============================================================================

# Comma-separated list of allowed usernames (case-insensitive)
ALLOWED_USERS=admin,user1

# Whether to enforce the allowed users list
ENFORCE_USERS=True

# Password hashes for users (generate with bcrypt)
# Example: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt()).decode())"
admin=$2b$12$example_hash_replace_with_real_hash
user1=$2b$12$example_hash_replace_with_real_hash

# Security settings
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database URL - Examples:
# SQLite (default): sqlite:///jarvis.db
# PostgreSQL: postgresql://user:password@localhost/jarvis
# MySQL: mysql://user:password@localhost/jarvis
DATABASE_URL=postgresql://jarvis:your_secure_postgres_password_here@localhost:5432/jarvis_db

# Production Database (Docker)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Database connection settings
DATABASE_ECHO=False
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching and session storage)
# =============================================================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# =============================================================================
# PRODUCTION DEPLOYMENT CONFIGURATION
# =============================================================================

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Monitoring Configuration  
GRAFANA_PASSWORD=your_secure_grafana_password_here

# SSL Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Backup Configuration
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# API KEYS (At least one LLM provider required)
# =============================================================================

# LLM Providers (need at least one)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
MISTRALAI_API_KEY=
CODESTRAL_API_KEY=

# Search and Research APIs
SERPER_API_KEY=
PERPLEXITY_API_KEY=

# Audio/Speech APIs
ELEVENLABS_API_KEY=

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Chainlit authentication
CHAINLIT_AUTH_SECRET=

# AWS S3 configuration
BUCKET_NAME=
APP_AWS_ACCESS_KEY=
APP_AWS_SECRET_KEY=
APP_AWS_REGION=

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Default model settings
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=8192
MODEL_STREAMING=False
RECURSION_LIMIT=250

# =============================================================================
# AUDIO SETTINGS
# =============================================================================

MPV_INSTALLED=False
DEFAULT_LANGUAGE=en
AUDIO_TIMEOUT=30

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=False

# Server settings
HOST=0.0.0.0
PORT=8000

# Application identity
JARVIS_NAME=Jarvis_MK42
SUPERVISOR_PROMPT_NAME=supervisor

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

LOG_LEVEL=INFO
LOG_FILE_PATH=app.log
LOG_MAX_FILE_SIZE=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# TOOL RESTRICTIONS
# =============================================================================

# Global tool restrictions (uncomment to enable)
#JARVIS_ALLOWED_TOOLS=research_tool,coding_tool,calculator_tool

# Agent-specific tool restrictions
RESEARCH_AGENT_ALLOWED_TOOLS=advanced_research_tool,google_search_tool,images_search_tool,webpage_research_tool
REASONING_AGENT_ALLOWED_TOOLS=sequential_thinking_tool,generate_summary,clear_history,reasoning_model_tool,advanced_research_tool,google_search_tool,images_search_tool,webpage_research_tool
REASONING_MODEL_AGENT_ALLOWED_TOOLS=reasoning_model_tool
CODING_AGENT_ALLOWED_TOOLS=list_jarvis_files,read_file_content,sequential_thinking_tool,generate_summary,clear_history,reasoning_model_tool,advanced_research_tool,google_search_tool,images_search_tool,webpage_research_tool


